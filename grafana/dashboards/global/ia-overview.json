    },
    {
      "id": 12,
      "title": "Telemetría de Claude Code en el periodo",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Lo que ha recibido el OTel Collector de Claude Code en el periodo y lo que ha guardado Loki. «Rechazados o no guardados» por encima de 0 significa eventos perdidos (el coste se recalcula con la tabla de precios, pero se pierden el effort y las llamadas que no se escriben en la conversación). Los contadores empiezan de cero al reiniciar el servicio.",
      "gridPos": {
        "x": 18,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"otelcol_receiver_accepted_log_records(_total)?\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "Eventos recibidos"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"otelcol_receiver_accepted_metric_points(_total)?\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "Puntos de métricas recibidos"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"otelcol_receiver_refused_log_records|otelcol_exporter_send_failed_log_records(_total)?\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "Rechazados o no guardados"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"loki_distributor_lines_received(_total)?\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "Líneas guardadas en Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
