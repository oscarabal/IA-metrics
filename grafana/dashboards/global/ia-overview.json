    {
      "id": 11,
      "title": "Servicios",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Si Prometheus llega a cada servicio. Los de una herramienta que no instalaste salen como caídos: claude-collector, otel-collector y loki son de Claude Code; opencode, de OpenCode.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"claude-collector|otel-collector|loki|opencode\"}",
